<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="NoCodeAutify">
    <test name="Window and Signup Scenarios">
        <groups>
            <run>
                <include name="windows"/>
                <include name="signup"/>
            </run>
        </groups>
        <classes>
            <class name="comprehensive.NoCodeAutifySignUpTest"/>
            <class name="comprehensive.NoCodeAutifySwitchWindowTest"/>
        </classes>
    </test>
</suite>